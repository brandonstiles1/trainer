# ─────────────────────────────────────────────────────────────
# Copy this to .env.local and fill in values.
# Everything below is required for local dev.
# ─────────────────────────────────────────────────────────────

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Supabase Postgres — Dashboard → Project Settings → Database → URI (Transaction pooler)
DATABASE_URL="postgresql://postgres:<password>@aws-<region>.pooler.supabase.com:6543/postgres"
